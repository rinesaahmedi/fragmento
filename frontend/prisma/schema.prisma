generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KitchenStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ItemType {
  COMPONENT
  ACCESSORY
  SERVICE
}

enum OrderStatus {
  NEW
  EMAILED
  CONFIRMED
  CANCELLED
}

enum AdminRole {
  SUPERADMIN
  ADMIN
  USER
}

model AdminUser {
  id                         String    @id @default(cuid())
  email                      String    @unique
  passwordHash               String
  role                       AdminRole @default(ADMIN)
  isActive                   Boolean   @default(true)
  loginVerificationCodeHash  String?
  loginVerificationExpiresAt DateTime?
  loginVerificationAttempts  Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CatalogArticle {
  id                  String        @id @default(cuid())
  articleNumber       String        @unique
  name                String
  nameDe              String?
  description         String?
  widthMm             Int?
  heightMm            Int?
  depthMm             Int?
  price               Decimal       @db.Decimal(10, 2)
  itemType            ItemType
  isFixedPricePackage Boolean       @default(false)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  kitchenItems        KitchenItem[]
}

model CatalogBlende {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  nameDe       String?
  description  String?
  price        Decimal       @db.Decimal(10, 2)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  kitchenItems KitchenItem[]
}

model CatalogService {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  nameDe       String?
  description  String?
  price        Decimal       @db.Decimal(10, 2)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  kitchenItems KitchenItem[]
}

model Kitchen {
  id          String            @id @default(cuid())
  slug        String            @unique
  kitchenCode String?
  programmId  String            @default("IP 2200")
  name        String
  status      KitchenStatus     @default(DRAFT)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       KitchenItem[]
  orders      Order[]
  testOrders  TestOrder[]
  contracts   KitchenContract[]
}

model KitchenItem {
  id                       String          @id @default(cuid())
  kitchenId                String
  kitchen                  Kitchen         @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  itemType                 ItemType
  code                     String
  articleNumber            String?
  name                     String
  nameDe                   String?
  price                    Decimal         @db.Decimal(10, 2)
  widthMm                  Int?
  heightMm                 Int?
  depthMm                  Int?
  infoText                 String?
  productImagePath         String?
  productInfoPdfPath       String?
  productInfoSummary       String?
  productInfoKeyFacts      Json?
  productInfoExtractedText String?
  productInfoUpdatedAt     DateTime?
  iconKey                  String?
  colorKey                 String?
  componentKey             String?
  isLocked                 Boolean         @default(false)
  isActive                 Boolean         @default(true)
  sortOrder                Int             @default(0)
  blendeCode               String?
  blendeLabel              String?
  blendePrice              Decimal?        @db.Decimal(10, 2)
  catalogArticleId         String?
  catalogArticle           CatalogArticle? @relation(fields: [catalogArticleId], references: [id], onDelete: SetNull)
  catalogBlendeId          String?
  catalogBlende            CatalogBlende?  @relation(fields: [catalogBlendeId], references: [id], onDelete: SetNull)
  catalogBlendeQuantity    Int?
  catalogServiceId         String?
  catalogService           CatalogService? @relation(fields: [catalogServiceId], references: [id], onDelete: SetNull)
  catalogLinkStatus        String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  orderItems               OrderItem[]
  testOrderItems           TestOrderItem[]

  @@unique([kitchenId, code])
  @@index([catalogArticleId])
  @@index([catalogBlendeId])
  @@index([catalogServiceId])
}

model Order {
  id                      String           @id @default(cuid())
  orderNumber             String           @unique
  kitchenId               String
  kitchen                 Kitchen          @relation(fields: [kitchenId], references: [id], onDelete: Restrict)
  kitchenContractId       String?
  kitchenContract         KitchenContract? @relation(fields: [kitchenContractId], references: [id], onDelete: SetNull)
  status                  OrderStatus      @default(NEW)
  contractNumber          String?
  firstName               String
  lastName                String
  email                   String
  phone                   String
  address1                String
  address2                String?
  postalCode              String
  city                    String
  country                 String?
  preferredDeliveryDate   DateTime?
  notes                   String?
  paymentMethod           String?
  paymentStatus           String           @default("UNPAID")
  stripeCheckoutSessionId String?          @unique
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  totalPrice              Decimal          @db.Decimal(10, 2)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  items                   OrderItem[]

  @@index([kitchenContractId])
}

model TestOrder {
  id                      String           @id @default(cuid())
  orderNumber             String           @unique
  kitchenId               String
  kitchen                 Kitchen          @relation(fields: [kitchenId], references: [id], onDelete: Restrict)
  kitchenContractId       String?
  kitchenContract         KitchenContract? @relation(fields: [kitchenContractId], references: [id], onDelete: SetNull)
  status                  OrderStatus      @default(NEW)
  contractNumber          String?
  firstName               String
  lastName                String
  email                   String
  phone                   String
  address1                String
  address2                String?
  postalCode              String
  city                    String
  country                 String?
  preferredDeliveryDate   DateTime?
  notes                   String?
  paymentMethod           String?
  paymentStatus           String           @default("UNPAID")
  stripeCheckoutSessionId String?          @unique
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  totalPrice              Decimal          @db.Decimal(10, 2)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  items                   TestOrderItem[]

  @@index([kitchenContractId])
}

model KitchenContract {
  id             String                @id @default(cuid())
  contractNumber String                @unique
  kitchenId      String
  kitchen        Kitchen               @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  isActive       Boolean               @default(true)
  usedAt         DateTime?
  building       String?
  floor          String?
  unitNumber     String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  orders         Order[]
  testOrders     TestOrder[]
  registrations  KitchenRegistration[]

  @@index([kitchenId])
  @@index([projectId])
}

model KitchenRegistration {
  id                    String          @id @default(cuid())
  kitchenContractId     String
  kitchenContract       KitchenContract @relation(fields: [kitchenContractId], references: [id], onDelete: Cascade)
  fullName              String
  email                 String?
  phone                 String?
  addressNote           String?
  isActive              Boolean         @default(true)
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int             @default(0)
  verifiedAt            DateTime?
  registeredAt          DateTime        @default(now())
  deactivatedAt         DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([kitchenContractId, isActive])
  @@index([email])
  @@index([phone])
}

model HousingCompany {
  id              String           @id @default(cuid())
  name            String
  address         String?
  email           String?
  phone           String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projects        Project[]
  propertyObjects PropertyObject[]
}

model Project {
  id               String            @id @default(cuid())
  name             String
  projectCode      String?
  status           String            @default("active")
  description      String?
  managerName      String?
  housingCompanyId String
  housingCompany   HousingCompany    @relation(fields: [housingCompanyId], references: [id], onDelete: Cascade)
  propertyObjectId String            @unique
  propertyObject   PropertyObject    @relation(fields: [propertyObjectId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contracts        KitchenContract[]

  @@unique([housingCompanyId, name])
  @@index([housingCompanyId])
}

model PropertyObject {
  id               String         @id @default(cuid())
  name             String
  housingCompanyId String
  housingCompany   HousingCompany @relation(fields: [housingCompanyId], references: [id], onDelete: Cascade)
  project          Project?
  contactPhone     String?
  country          String?
  city             String?
  postalCode       String?
  address1         String?
  address2         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([housingCompanyId])
}

model OrderItem {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitchenItemId String?
  kitchenItem   KitchenItem? @relation(fields: [kitchenItemId], references: [id], onDelete: SetNull)
  itemType      ItemType
  code          String
  nameSnapshot  String
  priceSnapshot Decimal      @db.Decimal(10, 2)
  quantity      Int          @default(1)
  createdAt     DateTime     @default(now())
}

model TestOrderItem {
  id            String       @id @default(cuid())
  orderId       String
  order         TestOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitchenItemId String?
  kitchenItem   KitchenItem? @relation(fields: [kitchenItemId], references: [id], onDelete: SetNull)
  itemType      ItemType
  code          String
  nameSnapshot  String
  priceSnapshot Decimal      @db.Decimal(10, 2)
  quantity      Int          @default(1)
  createdAt     DateTime     @default(now())
}

model ServiceClaim {
  id                   String   @id
  contractNumber       String
  fullName             String
  phone                String?
  email                String?
  clientAddress        String?
  clientCountry        String?
  clientCity           String?
  clientPostalCode     String?
  landlordName         String?
  landlordCompanyPhone String?
  landlordCompanyEmail String?
  landlordPhone        String?
  landlordEmail        String?
  hausmeisterName      String?
  hausmeisterPhone     String?
  hausmeisterEmail     String?
  landlordContact      String
  problemDescription   String
  serialNumber         String
  requestType          String   @default("complaint")
  problemAreasJson     String?  @db.Text
  attachmentsJson      String?  @db.Text
  createdAt            DateTime @default(now())

  @@index([contractNumber])
  @@index([createdAt])
}

model PublicVisitEvent {
  id                  String   @id @default(cuid())
  eventType           String
  source              String?
  path                String?
  contractNumberHash  String?
  contractNumberLast4 String?
  ipHash              String?
  userAgentHash       String?
  metadata            Json?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([contractNumberHash])
}

model ServiceClaimKnowledgeEntry {
  id            String   @id @default(cuid())
  slug          String   @unique
  brand         String
  applianceType String
  topicType     String
  code          String?
  titleKey      String
  symptomKeys   Json?
  checkKeys     Json?
  causeKeys     Json?
  actionKeys    Json?
  triggerTerms  Json?
  priority      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([brand, applianceType, isActive])
  @@index([topicType, code])
}
